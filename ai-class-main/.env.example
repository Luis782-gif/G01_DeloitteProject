# Copie para .env (que o Git ignora). Sem segredos reais neste ficheiro.

# Base de dados. Com `npm run db` (Postgres embedded) este é o valor certo.
# Para Postgres nativo ou Docker, aponte para a sua instância.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/stock

# Porta da API (NestJS)
BACKEND_PORT=3001

# Onde o Next reencaminha /api/* (servidor a servidor; o browser só fala com o Next)
BACKEND_URL=http://localhost:3001

# Pasta com os 5 CSV reais (lidos só pelo ETL: npm run etl)
DATA_DIR=./data
